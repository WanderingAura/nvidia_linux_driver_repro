#version 450
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : require

// Identical to heap_dynamic.comp except that the base index comes from push
// data (vkCmdPushDataEXT) instead of from a storage buffer. The host pushes
// the value 0, so this must produce exactly the same output as the other
// two cases.
//
// Descriptor-heap pipelines have no VkPipelineLayout, so this push constant
// block is fed by vkCmdPushDataEXT rather than vkCmdPushConstants.

layout(local_size_x = 1) in;

layout(descriptor_heap) buffer Buf {
    uint values[];
} bufs[];

layout(push_constant) uniform PushData {
    uint base;  // host pushes 0
} pc;

void main() {
    bufs[4].values[0] = bufs[pc.base + 0].values[0];
    bufs[4].values[1] = bufs[pc.base + 1].values[0];
    bufs[4].values[2] = bufs[pc.base + 2].values[0];
    bufs[4].values[3] = bufs[pc.base + 3].values[0];
}
